<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_hud_bg"
    android:elevation="12dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_bolt" />

        <TextView
            android:id="@+id/overlay_badge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="CHARGER CONNECTED"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_source_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="AC"
            android:textColor="#9FB0C7"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/overlay_btn_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:contentDescription="Dismiss charging overlay"
            android:padding="4dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE WATTS"
                android:textColor="#9FB0C7"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_watts_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24.5 W"
                android:textColor="#00E676"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE AMPERE"
                android:textColor="#9FB0C7"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_amps_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+4,900 mA"
                android:textColor="#00D2FF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.85"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOLTAGE"
                android:textColor="#9FB0C7"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlay_voltage_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5.00 V"
                android:textColor="#F4F7FB"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_battery_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="65%"
            android:textColor="#F4F7FB"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/overlay_battery_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="65"
            android:progressDrawable="@drawable/widget_progress_drawable" />

        <TextView
            android:id="@+id/overlay_eta_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~35 min"
            android:textColor="#9FB0C7"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlay_health_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Health: Good • 33.1°C • Tap to open"
        android:textColor="#9FB0C7"
        android:textSize="11sp" />

</LinearLayout>
